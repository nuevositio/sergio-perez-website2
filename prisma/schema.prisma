generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  draft
  published
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum ExpenseCategory {
  hosting
  software
  services
  other
}

enum ExpenseStatus {
  received
  pending
  paid
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id             String     @id @default(cuid())
  title          String
  subtitle       String?
  slug           String     @unique
  excerpt        String
  content        String
  featuredImage  String?
  status         PostStatus @default(draft)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  authorId       String     @db.Uuid
  categoryId     String

  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("UYU") // "UYU" or "USD"
  status      InvoiceStatus @default(draft)
  issuedAt    DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  clientId    String
  description String?
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@index([currency])
}

model Expense {
  id          String           @id @default(cuid())
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @default("UYU") // "UYU" or "USD"
  category    ExpenseCategory
  status      ExpenseStatus    @default(received)
  provider    String
  date        DateTime
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([status])
  @@index([date])
  @@index([currency])
}

model PlannedInvestment {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("UYU")
  description String
  plannedDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plannedDate])
}
